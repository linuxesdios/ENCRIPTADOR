<Window x:Class="Encriptador.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contenido encriptado" Height="600" Width="480"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent">

    <Border Background="{StaticResource BrushFondoCard}" BorderBrush="{StaticResource BrushBorde}"
            BorderThickness="1" CornerRadius="18" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushAcento}">
                    <TextBlock Text="&#128193;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitulo" Text="Carpeta.enc" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextoPrincipal}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtSubtitulo" Text="0 archivos" FontSize="11.5"
                               Foreground="{StaticResource BrushTextoSecundario}"/>
                </StackPanel>
                <Button x:Name="BtnCerrar" Grid.Column="2" Content="&#10005;" Style="{StaticResource BotonIcono}"
                        Width="26" Height="26" Click="BtnCancelar_Click"/>
            </Grid>

            <TextBlock x:Name="TxtInstrucciones" Grid.Row="1" Text="Doble clic en un archivo para abrirlo. No se guarda nada en destino hasta que extraigas los seleccionados."
                       FontSize="11.5" Foreground="{StaticResource BrushTextoSecundario}"
                       TextWrapping="Wrap" Margin="0,14,0,10"/>

            <!-- Seleccionar / deseleccionar todo -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="BtnSeleccionarTodo" Content="Seleccionar todo" Style="{StaticResource BotonSecundario}"
                        Padding="10,5" FontSize="11.5" Margin="0,0,8,0" Click="BtnSeleccionarTodo_Click"/>
                <Button x:Name="BtnDeseleccionarTodo" Content="Deseleccionar todo" Style="{StaticResource BotonSecundario}"
                        Padding="10,5" FontSize="11.5" Click="BtnDeseleccionarTodo_Click"/>
            </StackPanel>

            <!-- Lista de archivos -->
            <Border Grid.Row="3" Background="#101A2C" BorderBrush="{StaticResource BrushBorde}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListaArchivos"/>
                </ScrollViewer>
            </Border>

            <!-- Acciones -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnCancelarAccion" Grid.Column="0" Content="Cancelar" Style="{StaticResource BotonSecundario}"
                        Click="BtnCancelar_Click"/>
                <Button x:Name="BtnExtraer" Grid.Column="2" Content="Extraer seleccionados" Style="{StaticResource BotonAcento}"
                        Click="BtnExtraer_Click"/>
            </Grid>

        </Grid>
    </Border>
</Window>
