<Window x:Class="Encriptador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Encriptador"
        mc:Ignorable="d"
        Title="Encriptador" Width="560" SizeToContent="Height"
        MinWidth="560" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFondoVentana}"
        Icon="Resources/icono.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Grid Margin="24,16,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Encabezado ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushAcento}">
                    <TextBlock Text="&#128274;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Encriptador" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <TextBlock x:Name="TxtTagline" Text="Cifrado AES-256-GCM de archivos" FontSize="11" Foreground="{StaticResource BrushTextoSecundario}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="PanelIdioma" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnIdiomaEs" Content="ES" Style="{StaticResource BotonSecundario}" Padding="6,3" FontSize="10" Margin="0,0,4,0" Click="BtnIdioma_Click"/>
                <Button x:Name="BtnIdiomaEn" Content="EN" Style="{StaticResource BotonSecundario}" Padding="6,3" FontSize="10" Margin="0,0,4,0" Click="BtnIdioma_Click"/>
                <Button x:Name="BtnIdiomaRu" Content="RU" Style="{StaticResource BotonSecundario}" Padding="6,3" FontSize="10" Margin="0,0,4,0" Click="BtnIdioma_Click"/>
                <Button x:Name="BtnIdiomaZh" Content="中" Style="{StaticResource BotonSecundario}" Padding="6,3" FontSize="10" Click="BtnIdioma_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===================== Tarjeta principal ===================== -->
        <Border Grid.Row="1" Background="{StaticResource BrushFondoCard}" BorderBrush="{StaticResource BrushBorde}"
                BorderThickness="1" CornerRadius="14" Padding="18" VerticalAlignment="Top">
            <StackPanel>

                <TextBlock x:Name="LblArchivo" Text="ARCHIVO" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoSecundario}" Margin="2,0,0,6"/>

                <!-- Zona de arrastrar y soltar / seleccionar archivo(s) -->
                <Border x:Name="ZonaArchivo" MinHeight="68" CornerRadius="10" Background="#101A2C"
                        BorderBrush="{StaticResource BrushBorde}" BorderThickness="1.5" Cursor="Hand"
                        MouseLeftButtonUp="ZonaArchivo_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAcento1Solido}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,10">
                        <TextBlock x:Name="IconoArchivo" Text="&#128193;" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtNombreArchivo" Text="Arrastrá archivo(s) o una carpeta aquí, o hacé clic para elegir"
                                   FontSize="12.5" Foreground="{StaticResource BrushTextoSecundario}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400"/>
                    </StackPanel>
                </Border>

                <!-- Contraseña -->
                <Grid Margin="2,12,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblContrasena" Text="CONTRASEÑA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoSecundario}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnMostrarPassword" Grid.Column="1" Content="Mostrar" Style="{StaticResource BotonSecundario}"
                            Padding="9,2" FontSize="10" Click="BtnMostrarPassword_Click"/>
                </Grid>
                <Grid>
                    <PasswordBox x:Name="TxtPassword" Style="{StaticResource PasswordBoxModerno}"
                                 PasswordChanged="TxtPassword_Changed" KeyDown="Password_KeyDown"/>
                    <TextBox x:Name="TxtPasswordVisible" Style="{StaticResource TextBoxModerno}" Visibility="Collapsed"
                             TextChanged="TxtPasswordVisible_Changed" KeyDown="Password_KeyDown"/>
                </Grid>

                <!-- Contenido exclusivo del modo "encriptar" -->
                <StackPanel x:Name="PanelModoEncriptar">

                    <TextBlock x:Name="LblRepetir" Text="REPETIR CONTRASEÑA" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextoSecundario}" Margin="2,10,0,6"/>
                    <Grid>
                        <PasswordBox x:Name="TxtConfirmar" Style="{StaticResource PasswordBoxModerno}" KeyDown="Password_KeyDown"/>
                        <TextBox x:Name="TxtConfirmarVisible" Style="{StaticResource TextBoxModerno}" Visibility="Collapsed" KeyDown="Password_KeyDown"/>
                    </Grid>

                    <Grid Margin="2,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <UniformGrid x:Name="PanelFuerza" Columns="4" Height="4" VerticalAlignment="Center">
                            <Border x:Name="Segmento1" CornerRadius="2" Margin="0,0,4,0" Background="#101A2C"/>
                            <Border x:Name="Segmento2" CornerRadius="2" Margin="0,0,4,0" Background="#101A2C"/>
                            <Border x:Name="Segmento3" CornerRadius="2" Margin="0,0,4,0" Background="#101A2C"/>
                            <Border x:Name="Segmento4" CornerRadius="2" Background="#101A2C"/>
                        </UniformGrid>
                        <TextBlock x:Name="TxtFuerza" Grid.Column="1" Text="" FontSize="10" Margin="8,0,0,0"
                                   Foreground="{StaticResource BrushTextoSecundario}" VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox x:Name="ChkBorradoSeguro" Content="Borrado seguro (sobrescribir antes de borrar)" IsChecked="True"
                              Style="{StaticResource CheckBoxModerno}" Margin="2,10,0,0"/>
                </StackPanel>

                <CheckBox x:Name="ChkConservarOriginal" Content="Conservar el archivo original (no borrarlo al terminar)"
                          Style="{StaticResource CheckBoxModerno}" Margin="2,10,0,0"
                          Checked="ChkConservarOriginal_Changed" Unchecked="ChkConservarOriginal_Changed"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnEncriptar" Grid.Column="0" Content="&#128272;  Encriptar" Style="{StaticResource BotonAcento}" Click="BtnEncriptar_Click"/>
                    <Button x:Name="BtnDesencriptar" Grid.Column="2" Content="&#128273;  Desencriptar" Style="{StaticResource BotonExito}" Click="BtnDesencriptar_Click"/>
                </Grid>

                <ProgressBar x:Name="BarraProgreso" Style="{StaticResource BarraModerna}" Margin="0,12,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="IconoEstado" Text="" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="TxtEstado" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{StaticResource BrushTextoSecundario}" VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ===================== Pie / créditos ===================== -->
        <Grid Grid.Row="2" Margin="4,10,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="22" Height="22" CornerRadius="11" ClipToBounds="True">
                <Border.Background>
                    <ImageBrush ImageSource="Resources/Autor.jpg" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <TextBlock x:Name="TxtCredito" Grid.Column="1" Text="Realizado por Pablo Martín Fernández"
                       FontSize="10.5" Foreground="{StaticResource BrushTextoSecundario}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>

            <Button x:Name="BtnAcerca" Grid.Column="2" Content="&#8505;" Style="{StaticResource BotonIcono}"
                    Click="BtnAcerca_Click"/>
        </Grid>

    </Grid>
</Window>
